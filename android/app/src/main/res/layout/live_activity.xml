<?xml version="1.0" encoding="utf-8"?>
<!-- Job Search Live Activity Card (Collapsed) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_live_activity_card"
        android:alpha="0.92"
        android:gravity="center_vertical">

    <!-- Company Logo -->
        <ImageView
            android:id="@+id/team1_image_placeholder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_live_activity_avatar"
            android:clipToOutline="true"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Company Logo" />

    <!-- Job Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

        <!-- Company Name -->
            <TextView
                android:id="@+id/team1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Компани нэр"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

        <!-- Job Title -->
            <TextView
                android:id="@+id/team2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ажлын байр"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

        <!-- Description -->
            <TextView
                android:id="@+id/score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Албан тушаалын тайлбар"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

        <!-- Posted Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Зарласан: "
                    android:textSize="11sp"
                    android:textColor="@android:color/tertiary_text_light" />

                <Chronometer
                    android:id="@+id/match_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@android:color/tertiary_text_light"
                    android:format="%s" />
            </LinearLayout>
        </LinearLayout>

    <!-- Hidden Team 2 Image (kept for compatibility) -->
        <ImageView
            android:id="@+id/team2_image_placeholder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
