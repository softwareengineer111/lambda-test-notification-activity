<?xml version="1.0" encoding="utf-8"?>
<!-- Job Search Live Activity Card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@android:color/transparent">

    <!-- Job Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <!-- Company Name -->
        <TextView
            android:id="@+id/team1_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Компани нэр"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Job Title -->
        <TextView
            android:id="@+id/team2_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ажлын байр"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Description -->
        <TextView
            android:id="@+id/score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Албан тушаалын тайлбар"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Company Logo (RIGHT SIDE) -->
    <ImageView
        android:id="@+id/team1_image_placeholder"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_company_circle"
        android:clipToOutline="true"
        android:src="@drawable/ic_company_placeholder"
        android:contentDescription="Company Logo" />

    <!-- Hidden Team 2 Image (compatibility) -->
    <ImageView
        android:id="@+id/team2_image_placeholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
